# Zkopíruj do .env a doplň hodnoty (.env je gitignorovaný).

# --- Databáze: Supabase PostgreSQL (Prisma) ---
# Ze Supabase → tlačítko Connect:
#   DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true  — běh aplikace (serverless)
#   DIRECT_URL   = Session / Direct connection (port 5432)           — migrace (prisma db push)
DATABASE_URL="postgresql://postgres.<ref>:<HESLO>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<HESLO>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (přihlášení Google + e-mail/heslo) — POVINNÉ ---
# Supabase → Project Settings → API. Bez nich nefunguje registrace/přihlášení.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Nahrávání fotek do galerie (Supabase Storage). TAJNÉ — jen server, nikdy NEXT_PUBLIC_. ---
# Supabase → Project Settings → API → service_role. Prázdné = fotky nejde nahrávat, jen spravovat.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI asistent (tainy Pro). Prázdné = ukázkový režim. ---
ANTHROPIC_API_KEY=

# --- E-maily hostům a majiteli (Resend). Prázdné = e-maily se jen vypíšou do konzole. ---
RESEND_API_KEY=
RESEND_FROM="tainy <rezervace@tvoje-domena.cz>"

# --- Veřejná adresa aplikace pro odkazy v e-mailech (na Vercelu se dopočítá sama). ---
NEXT_PUBLIC_APP_URL=

# --- Komu patří demo web ze seedu (aby byl vidět v administraci). Prázdné = bez vlastníka. ---
SEED_OWNER_EMAIL=
