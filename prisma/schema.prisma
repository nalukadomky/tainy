generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Site {
  id           String        @id @default(cuid())
  ownerId      String?       @db.Uuid
  slug         String        @unique
  name         String
  tagline      String        @default("")
  description  String        @default("")
  propertyType String        @default("chata")
  pricePerNight Int
  pricingMode  String        @default("unit")
  // Víkendová úprava: jednotka pct = ± %, czk = pevná cena noci
  weekendValue Int           @default(0)
  weekendUnit  String        @default("pct")
  maxGuests    Int           @default(4)
  amenities    String        @default("")
  // Skladba hostů: total = jeden čítač osob, split = kategorie
  guestMode       String     @default("total")
  guestCategories String     @default("") // JSON katalogu, prázdné = výchozí
  // Galerie: jedna fotka na řádek ve tvaru `adresa|popisek`
  photos       String        @default("")
  // Úvod webu: text = jen nadpis, photo = nadpis přes velkou úvodní fotku
  heroStyle    String        @default("text")
  heroPhoto    String        @default("")
  themeColor   String        @default("pine")
  tier         String        @default("start")
  contactEmail String        @default("")
  contactPhone String        @default("")

  // Pravidla pobytu
  minNights    Int           @default(1)
  leadTimeDays Int           @default(0)
  checkInTime  String        @default("15:00")
  checkOutTime String        @default("10:00")

  // Poplatky nad rámec ceny za noci (tvoří konečnou cenu)
  cleaningFee  Int           @default(0) // Kč za pobyt
  touristTax   Int           @default(0) // Kč / osoba / noc

  // Platba
  paymentMode        String  @default("qr") // qr | stripe | both
  bankAccount        String  @default("")   // IBAN pro QR platbu
  // DPH: plátce/neplátce a sazba (ceny v ceníku jsou vždy včetně DPH)
  vatPayer           Boolean @default(false)
  vatRate            Int     @default(12)
  cancellationPolicy String  @default("")
  // Úklid: výchozí úkoly (jeden na řádek) a co uklízečky uvidí o hostech
  // (čárkou: guests,name,note,phone). Cenu pobytu uklízečky nevidí nikdy.
  cleaningChecklist  String  @default("")
  cleanerFields      String  @default("guests")
  // Ložnice a lůžka (JSON, lib/sleeping.ts): počty ložnic, manželských postelí,
  // jednolůžek, přistýlek a pohovek (pohovka pro 1 nebo 2 osoby)
  sleeping           String  @default("")

  // Provozovatel (povinná identifikace podnikatele na webu)
  businessName     String  @default("") // jméno / obchodní firma
  businessId       String  @default("") // IČ
  vatId            String  @default("") // DIČ
  businessAddress  String  @default("") // sídlo / místo podnikání
  businessRegister String  @default("") // zápis v rejstříku

  // Obchodní podmínky a zásady ochrany osobních údajů: text (náš zápis
  // s formátováním) nebo PDF. PDF má přednost. UpdatedAt = verze dokumentu.
  termsText        String    @default("")
  termsPdf         String    @default("")
  termsName        String    @default("")
  termsUpdatedAt   DateTime?
  privacyText      String    @default("")
  privacyPdf       String    @default("")
  privacyName      String    @default("")
  privacyUpdatedAt DateTime?
  // Automatizace: nastavení e-mailů hostům (JSON, lib/email-templates.ts),
  // kódy k zámkům (JSON [{name, code}]) a informace k příjezdu
  emailSettings  String @default("")
  locks          String @default("")
  // Předání klíčů: code = elektronický zámek / kódy, key = fyzický klíč (kódy se nedoplňují)
  keyHandover    String @default("code")
  /// Widget na cizí web (lib/widget.ts): text a umístění plovoucího tlačítka
  widgetSettings String @default("{}")
  /// Majitel má vlastní web a používá jen widget — veřejný web v tainy nemá
  widgetOnly     Boolean @default(false)
  arrivalAddress String @default("")
  arrivalInfo    String @default("")
  wifiName       String @default("")
  wifiPassword   String @default("")
  // Sekce „O nás“ (příběh majitele): zapnutí, šablona vzhledu a obsah
  aboutEnabled   Boolean @default(false)
  aboutLayout    String  @default("photo-left") // photo-left | photo-right | quote | text
  aboutTitle     String  @default("O nás")
  aboutText      String  @default("")
  aboutPhoto     String  @default("")
  aboutPhotoCrop String  @default("")
  aboutPhotoShape String @default("auto") // auto (výška podle textu) | portrait | square | landscape // výřez fotky „x,y,zoom“ (lib/crop.ts), prázdné = střed
  aboutSignature String  @default("")
  // Sekce Recenze: zapnutí a recenze hostů (JSON, lib/reviews.ts)
  reviewsEnabled Boolean @default(false)
  reviews        String  @default("")
  // Vzhled recenzí: grid = mřížka, slider = posuvník do stran
  reviewsLayout  String  @default("grid")
  // Pořadí sekcí mezi Úvodem a Patičkou (lib/sections.ts), prázdné = výchozí
  sectionOrder   String  @default("")
  // Vlastní nadpisy sekcí (JSON, lib/sections.ts), prázdné = výchozí
  sectionTitles  String  @default("")
  // Tón podkladu (lib/theme.ts TONES), prázdné = automaticky podle hlavní barvy
  surfaceTone    String  @default("")
  // Vidí personál úkoly, které si majitel zapsal sám pro sebe?
  staffSeesOwnerTodos Boolean @default(true)
  // Vlastní doména webu (např. chata-olinka.cz), připojená přes Vercel (lib/domains.ts)
  customDomain     String?   @unique
  domainStatus     String    @default("") // pending | active | error
  domainVerifiedAt DateTime?
  // Poloha na webu: none | area (jen obec, kruh na mapě) | exact (adresa se špendlíkem).
  // geo = souřadnice dohledané z adresy při uložení (JSON, lib/location.ts)
  locationMode   String @default("area")
  geo            String @default("")
  // Externí rezervace: tajný odkaz na kalendář webu pro portály (/api/ical/<token>.ics)
  icalToken      String? @unique
  /// Tajná adresa pro přeposílané e-maily z Airbnb/Bookingu: <slug>-<token>@in.tainy.cz
  inboundToken   String? @unique
  /// Volitelná pojistka: přijímat jen e-maily přeposlané z této adresy
  inboundFrom    String  @default("")
  /// Kdy majitel naposledy potvrdil nové rezervace na Přehledu („Od minula přišly…“)
  newSeenAt      DateTime?
  // Online check-in (kniha ubytovaných): zapnutí (tlačítko u rezervace hosta);
  // e-mail s odkazem je v emailSettings.checkin, ráno v den příjezdu připomínka
  checkinEnabled  Boolean @default(true)
  // Správa úklidů (sekce Úklid, úklidy po pobytech, odkazy personálu, upozornění na Přehledu)
  cleaningEnabled Boolean @default(true)
  checkinReminder Boolean @default(true)
  // Ubyport (hlášení cizinců): identifikátor ubytovatele a zkratka od policie
  ubyportIdub     String  @default("")
  ubyportAbbr     String  @default("")
  // Poplatek z pobytu: jak často se odvádí obci (month | quarter | half | year)
  // a výsledek dohledání vyhlášky obce ve Sbírce (JSON, lib/tourist-tax.ts)
  taxPeriod       String  @default("quarter")
  taxSource       String  @default("")

  createdAt    DateTime      @default(now())
  reservations Reservation[]
  costs        Cost[]
  priceRules   PriceRule[]
  blackouts    Blackout[]
  vouchers     Voucher[]
  cleaners     Cleaner[]
  cleanings    Cleaning[]
  todos        Todo[]
  feeds        CalendarFeed[]
  guestRecords GuestRecord[]
  inboundMails InboundMail[]
  remittances  TaxRemittance[]
  accessLogs   GuestAccessLog[]
  giftOffers   GiftOffer[]
  giftOrders   GiftOrder[]

  @@index([ownerId])
}

model PriceRule {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  // Stejná dvojice jako u víkendu: pct = ± %, czk = pevná cena noci
  value     Int
  unit      String   @default("pct")
  createdAt DateTime @default(now())

  @@index([siteId])
}

model Reservation {
  id         String   @id @default(cuid())
  publicId   String   @unique
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  guestName  String
  firstName  String   @default("") // křestní jméno — podle něj se hosta oslovuje
  // Host byl smazán, ale rezervace zůstala kvůli příjmům — bez osobních údajů
  anonymized Boolean  @default(false)
  // Anonymizovaný host (nesouhlas s GDPR): „Host č. 4821" — zůstává ve statistikách hostů
  guestRef   String   @default("")
  // Kód k zámku / schránce s klíči pro tenhle pobyt (vidí ho jen majitel)
  accessCode String   @default("")
  accessCodeSetAt DateTime? // kdy byl kód zadaný (uložený na poslední chvíli = odeslat hned)
  email      String
  phone      String   @default("")
  guests     Int                          // osoby počítané do kapacity
  guestBreakdown String @default("")       // JSON skladby, např. {"adult":2,"child":1}
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  // Check-in / check-out pobytu (HH:MM) — při vytvoření se zkopírují z webu,
  // pozdější změna v ceníku je nemění; jde je upravit u jednotlivé rezervace.
  checkInTime  String @default("")
  checkOutTime String @default("")

  nightsTotal Int     @default(0) // cena za noci
  feesTotal   Int     @default(0) // úklid + poplatek z pobytu
  totalPrice  Int                 // nightsTotal + feesTotal − discount

  // Uplatněný voucher — snímek v době rezervace, pozdější úprava voucheru ho nemění
  voucherCode  String  @default("")
  voucherKind  String  @default("")   // pct | czk
  voucherValue Int     @default(0)
  discount     Int     @default(0)    // sleva v Kč
  // DPH v době rezervace (0 = ubytovatel nebyl plátce); obsažené v ceně
  vatRate      Int     @default(0)
  vatAmount    Int     @default(0)

  note       String   @default("")
  source     String   @default("web") // web | manual | airbnb | booking
  // Testovací rezervace z vývoje — hostovi se nikdy nic automaticky neposílá
  noGuestMail Boolean @default(false)
  status     String   @default("pending")
  expiresAt  DateTime?                // nezaplacená rezervace po expiraci uvolní termín
  // Souhlas hosta s obchodními podmínkami: kdy a s jakou verzí (termsUpdatedAt webu)
  termsAcceptedAt DateTime?
  termsVersion    String   @default("")
  createdAt  DateTime @default(now())
  cleaning   Cleaning?
  mails      GuestMail[]
  // Stažené z kalendáře portálu (iCal): kalendář a UID události v něm
  feedId      String?
  feed        CalendarFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalUid String?

  // Kdy rezervace přešla do stavu zaplaceno / zrušeno (návrat stavu je vynuluje)
  paidAt      DateTime?
  cancelledAt DateTime?
  // Kdy odešly e-maily hostovi (lib/guest-mails.ts) — každý nanejvýš jednou
  paidMailAt        DateTime?
  cancelMailAt      DateTime?
  arrivalMailAt     DateTime?
  arrivalCodeMailAt DateTime? // kód k zámku zadaný až po e-mailu „Před příjezdem“

  // Online check-in: nonce podepsaného odkazu (změna = starý odkaz přestane platit),
  // kdy odešel odkaz / připomínka a kdy host vyplnil všechny osoby
  checkinNonce      String    @default("")
  checkinMailAt     DateTime?
  checkinReminderAt DateTime?
  checkinDoneAt     DateTime?
  guestRecords      GuestRecord[]

  // Údaje z přeposlaného e-mailu Airbnb/Bookingu (lib/portal-mail.ts): kód rezervace
  // na portálu, vytažená data (JSON: hosté, cena pro hosta, výplata, měna…) a kdy přišla
  // Nabídky dalšího pobytu (§ 7 odst. 3 z. 480/2004 Sb.): kdy host odmítl / se odhlásil
  offersOptOutAt DateTime?

  portalCode    String    @default("")
  portalData    String    @default("")
  portalMailAt  DateTime?
  inboundMails  InboundMail[]

  @@unique([feedId, externalUid])
  @@index([siteId, startDate, endDate])
}

// Blokace termínu majitelem (údržba, vlastní pobyt) — chová se jako obsazeno.
model Blackout {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String   @default("")
  createdAt DateTime @default(now())
  // Stažené z kalendáře portálu (iCal)
  feedId      String?
  feed        CalendarFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalUid String?

  @@unique([feedId, externalUid])
  @@index([siteId, startDate, endDate])
}

// Kalendář z portálu (Airbnb, Booking.com…) stahovaný přes iCal — obsazené
// termíny z něj se zapíšou jako rezervace nebo blokace (lib/ical-sync.ts).
model CalendarFeed {
  id           String        @id @default(cuid())
  siteId       String
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source       String        @default("other") // airbnb | booking | other
  name         String        @default("")
  url          String
  lastSyncAt   DateTime?
  lastError    String        @default("")
  eventCount   Int           @default(0)
  createdAt    DateTime      @default(now())
  reservations Reservation[]
  blackouts    Blackout[]

  @@index([siteId])
}

model Cost {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  amount    Int
  category  String   @default("provoz")
  // Jednorázový náklad nastane v `date`. Opakovaný (monthly | yearly) začíná
  // v `date` a opakuje se ve stejný den měsíce/roku, dokud ho majitel neukončí.
  repeat    String   @default("once")
  endDate   DateTime? // poslední den, kdy se opakovaný náklad ještě počítá
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([siteId, date])
}

// Slevový kód webu. Použití = nezrušené rezervace se stejným kódem.
model Voucher {
  id        String    @id @default(cuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code      String                         // velkými písmeny
  kind      String    @default("pct")      // pct = procenta, czk = pevná částka
  value     Int
  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date
  maxUses   Int?                           // null = bez omezení
  note      String    @default("")         // interní poznámka majitele
  active    Boolean   @default(true)
  /// Vznikl prodejem dárkového poukazu (GiftOrder) — v seznamu slevových kódů se neukazuje
  gift      Boolean   @default(false)
  /// Dárkový víkend: pobyt musí obsahovat noc z pátku na sobotu a ze soboty na neděli
  weekend   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@unique([siteId, code])
}

// Uklízečka webu. Přistupuje přes tajný odkaz /uklid/[token] (bez přihlášení).
model Cleaner {
  id        String     @id @default(cuid())
  siteId    String
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  token     String     @unique
  payMode   String     @default("hourly") // hourly = Kč/h, flat = Kč za úklid
  rate      Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  cleanings Cleaning[]
  todos     Todo[]

  @@index([siteId])
}

// Úklid: buď po odjezdu hostů z jedné rezervace (vzniká při přiřazení uklízečky),
// nebo ruční — bez rezervace, s vlastním datem, časem a popisem (vytvoří ho
// majitel, nebo si ho zapíše uklízečka).
model Cleaning {
  id            String       @id @default(cuid())
  siteId        String
  site          Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  date          DateTime?    @db.Date // jen ruční úklid
  time          String       @default("")
  title         String       @default("")
  createdBy     String       @default("owner") // owner | cleaner
  cleanerId     String?
  cleaner       Cleaner?    @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  checklist     String      @default("[]") // JSON [{id,label,done,extra}]
  minutes       Int?
  status        String      @default("todo") // todo | done
  finishedAt    DateTime?
  note          String      @default("")
  paid          Boolean     @default(false)
  paidAt        DateTime?
  amount        Int?        // částka v době zaplacení
  costId        String?     // záznam v Nákladech vytvořený při zaplacení
  createdAt     DateTime    @default(now())

  @@index([siteId, date])
}

// Úkoly (To-Do) majitele a personálu: Nákupy, Opravy, Provoz. Úkol patří
// majiteli (cleanerId = null), nebo konkrétní uklízečce. Uklízečka vidí své
// a majitelovy, odškrtnout smí své, smazat jen ty, které sama přidala.
model Todo {
  id          String    @id @default(cuid())
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title       String
  note        String    @default("")
  category    String    @default("provoz") // nakup | oprava | provoz
  cleanerId   String?
  cleaner     Cleaner?  @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  createdBy   String    @default("owner") // owner | cleaner
  createdById String?   // ID uklízečky, která úkol přidala
  urgent      Boolean   @default(false) // „Hoří“ — priorita, v seznamu nahoře
  done        Boolean   @default(false)
  doneAt      DateTime?
  doneBy      String    @default("") // jméno toho, kdo úkol odškrtl
  deletedAt   DateTime? // smazaný = v „karanténě“ (jde vrátit), po 30 dnech se smaže natrvalo
  createdAt   DateTime  @default(now())

  @@index([siteId, done])
}

// Odeslaný e-mail hostovi — přesně to, co odešlo (časová osa v detailu rezervace)
model GuestMail {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  kind          String      // booking | paid | arrival | arrivalCode | cancelled
  subject       String
  html          String
  sentAt        DateTime    @default(now())

  @@index([reservationId])
}

/// Import existujícího webu do tainy (sken → kontrola → nový web). Později se
/// k němu přidá platba.
model ImportJob {
  id        String   @id @default(cuid())
  ownerId   String   @db.Uuid
  url       String
  host      String
  /// scanned | done | failed
  status    String   @default("scanned")
  /// Výsledek skenu (JSON ImportResult)
  result    String   @default("")
  siteId    String?
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

/// Žádost o přístup do aplikace před veřejným spuštěním (early access).
model EarlyAccessRequest {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("")
  /// chata | tiny house | apartmán | glamping | jiné
  propertyType String    @default("")
  website      String    @default("")
  /// Odkud žádost přišla: landing | register | onboarding | import
  source       String    @default("")
  /// SHA-256 IP adresy (jen kvůli limitu žádostí, IP se neukládá)
  ipHash       String    @default("")
  /// Kdy dal souhlas se zpracováním osobních údajů (doklad pro GDPR)
  consentAt    DateTime?
  createdAt    DateTime  @default(now())
  /// Kdy jsme poslali přístup (označí se ručně ve správě)
  invitedAt    DateTime?

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

/// Kniha ubytovaných: jedna osoba pobytu. Údaje jsou šifrované v aplikaci
/// (AES-256-GCM, lib/guest-crypto.ts) — v databázi je jen „v1:…“. Po uplynutí
/// zákonné lhůty (purgeAt) je denní cron smaže.
model GuestRecord {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  position      Int
  data          String
  /// Cizinec (jiné občanství než ČR) — pro export do Ubyportu bez dešifrování
  foreign       Boolean     @default(false)
  /// guest = vyplnil host přes odkaz, owner = majitel v administraci
  filledBy      String      @default("guest")
  /// Cizinec nahlášený policii (Ubyport) — majitel označí po nahrání souboru
  reportedAt    DateTime?
  purgeAt       DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([reservationId, position])
  @@index([siteId, purgeAt])
}

/// Odvod poplatku z pobytu obci za období (např. 2026-Q4).
model TaxRemittance {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  period    String
  amount    Int
  paidAt    DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([siteId, period])
}

/// Kdo a kdy si zobrazil nebo exportoval údaje z knihy ubytovaných.
model GuestAccessLog {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userEmail String
  /// view | export | edit | delete
  action    String
  target    String   @default("")
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

/// Dárkový poukaz v nabídce na webu (Vouchery → Dárkové poukazy).
model GiftOffer {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// value = částka na pobyt, weekend = víkend pá–ne (2 noci) pro `persons` osob
  kind        String   @default("value")
  value       Int      @default(0)
  persons     Int      @default(2)
  price       Int
  headline    String   @default("")
  message     String   @default("")
  validMonths Int      @default(12)
  template    String   @default("klasik") // klasik | fotka | minimal | tma
  color       String   @default("#2c5e3f")
  photo       String   @default("")
  onSale      Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      GiftOrder[]

  @@index([siteId])
}

/// Objednávka dárkového poukazu z webu. Po zaplacení vznikne kód (Voucher, gift).
model GiftOrder {
  id          String    @id @default(cuid())
  /// Číslo objednávky pro lidi a variabilní symbol (krátké, jde uhodnout)
  publicId    String    @unique
  /// Tajný klíč do odkazu /darek/… (stránka ukazuje kód poukazu)
  accessToken String    @unique @default(cuid())
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  offerId     String?
  offer       GiftOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// Snímek poukazu v době nákupu (JSON) — pozdější úprava nabídky ho nemění
  design      String
  price       Int
  buyerName   String
  buyerEmail  String
  /// Fakturační údaje kupujícího
  buyerPhone  String    @default("")
  buyerStreet String    @default("")
  buyerCity   String    @default("")
  buyerZip    String    @default("")
  recipient   String    @default("")
  dedication  String    @default("")
  status      String    @default("pending") // pending | paid | cancelled
  paidAt      DateTime?
  code        String    @default("")        // kód poukazu (Voucher.code) po zaplacení
  validTo     DateTime? @db.Date
  termsAcceptedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([siteId, createdAt])
}

/// Přeposlaný e-mail z Airbnb/Bookingu (nebo ověření přeposílání Gmailu) na tajnou
/// adresu nemovitosti. Text a HTML se po spárování / po 30 dnech mažou, zůstane `parsed`.
model InboundMail {
  id            String       @id @default(cuid())
  resendId      String       @unique
  siteId        String
  site          Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  receivedAt    DateTime     @default(now())
  from          String       @default("")
  subject       String       @default("")
  provider      String       @default("other") // airbnb | booking | gmail | other
  kind          String       @default("unknown") // new | cancel | change | verify | unknown
  parsed        String       @default("{}") // JSON (lib/portal-mail.ts)
  status        String       @default("pending") // matched | pending | unreadable | ignored
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  text          String       @default("")
  html          String       @default("")

  @@index([siteId, receivedAt])
}
