generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Site {
  id           String        @id @default(cuid())
  ownerId      String?       @db.Uuid
  slug         String        @unique
  name         String
  tagline      String        @default("")
  description  String        @default("")
  propertyType String        @default("chata")
  pricePerNight Int
  pricingMode  String        @default("unit")
  // Víkendová úprava: jednotka pct = ± %, czk = pevná cena noci
  weekendValue Int           @default(0)
  weekendUnit  String        @default("pct")
  maxGuests    Int           @default(4)
  amenities    String        @default("")
  // Skladba hostů: total = jeden čítač osob, split = kategorie
  guestMode       String     @default("total")
  guestCategories String     @default("") // JSON katalogu, prázdné = výchozí
  // Galerie: jedna fotka na řádek ve tvaru `adresa|popisek`
  photos       String        @default("")
  // Úvod webu: text = jen nadpis, photo = nadpis přes velkou úvodní fotku
  heroStyle    String        @default("text")
  heroPhoto    String        @default("")
  themeColor   String        @default("pine")
  tier         String        @default("start")
  contactEmail String        @default("")
  contactPhone String        @default("")

  // Pravidla pobytu
  minNights    Int           @default(1)
  leadTimeDays Int           @default(0)
  checkInTime  String        @default("15:00")
  checkOutTime String        @default("10:00")

  // Poplatky nad rámec ceny za noci (tvoří konečnou cenu)
  cleaningFee  Int           @default(0) // Kč za pobyt
  touristTax   Int           @default(0) // Kč / osoba / noc

  // Platba
  paymentMode        String  @default("qr") // qr | stripe | both
  bankAccount        String  @default("")   // IBAN pro QR platbu
  // DPH: plátce/neplátce a sazba (ceny v ceníku jsou vždy včetně DPH)
  vatPayer           Boolean @default(false)
  vatRate            Int     @default(12)
  cancellationPolicy String  @default("")
  // Úklid: výchozí úkoly (jeden na řádek) a co uklízečky uvidí o hostech
  // (čárkou: guests,name,note,phone). Cenu pobytu uklízečky nevidí nikdy.
  cleaningChecklist  String  @default("")
  cleanerFields      String  @default("guests")
  // Ložnice a lůžka (JSON, lib/sleeping.ts): počty ložnic, manželských postelí,
  // jednolůžek, přistýlek a pohovek (pohovka pro 1 nebo 2 osoby)
  sleeping           String  @default("")

  // Provozovatel (povinná identifikace podnikatele na webu)
  businessName     String  @default("") // jméno / obchodní firma
  businessId       String  @default("") // IČ
  vatId            String  @default("") // DIČ
  businessAddress  String  @default("") // sídlo / místo podnikání
  businessRegister String  @default("") // zápis v rejstříku

  // Obchodní podmínky a zásady ochrany osobních údajů: text (náš zápis
  // s formátováním) nebo PDF. PDF má přednost. UpdatedAt = verze dokumentu.
  termsText        String    @default("")
  termsPdf         String    @default("")
  termsName        String    @default("")
  termsUpdatedAt   DateTime?
  privacyText      String    @default("")
  privacyPdf       String    @default("")
  privacyName      String    @default("")
  privacyUpdatedAt DateTime?
  // Automatizace: nastavení e-mailů hostům (JSON, lib/email-templates.ts),
  // kódy k zámkům (JSON [{name, code}]) a informace k příjezdu
  emailSettings  String @default("")
  locks          String @default("")
  arrivalAddress String @default("")
  arrivalInfo    String @default("")
  wifiName       String @default("")
  wifiPassword   String @default("")

  createdAt    DateTime      @default(now())
  reservations Reservation[]
  costs        Cost[]
  priceRules   PriceRule[]
  blackouts    Blackout[]
  vouchers     Voucher[]
  cleaners     Cleaner[]
  cleanings    Cleaning[]

  @@index([ownerId])
}

model PriceRule {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  // Stejná dvojice jako u víkendu: pct = ± %, czk = pevná cena noci
  value     Int
  unit      String   @default("pct")
  createdAt DateTime @default(now())
}

model Reservation {
  id         String   @id @default(cuid())
  publicId   String   @unique
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  guestName  String
  firstName  String   @default("") // křestní jméno — podle něj se hosta oslovuje
  // Host byl smazán, ale rezervace zůstala kvůli příjmům — bez osobních údajů
  anonymized Boolean  @default(false)
  // Anonymizovaný host (nesouhlas s GDPR): „Host č. 4821" — zůstává ve statistikách hostů
  guestRef   String   @default("")
  // Kód k zámku / schránce s klíči pro tenhle pobyt (vidí ho jen majitel)
  accessCode String   @default("")
  accessCodeSetAt DateTime? // kdy byl kód zadaný (uložený na poslední chvíli = odeslat hned)
  email      String
  phone      String   @default("")
  guests     Int                          // osoby počítané do kapacity
  guestBreakdown String @default("")       // JSON skladby, např. {"adult":2,"child":1}
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  // Check-in / check-out pobytu (HH:MM) — při vytvoření se zkopírují z webu,
  // pozdější změna v ceníku je nemění; jde je upravit u jednotlivé rezervace.
  checkInTime  String @default("")
  checkOutTime String @default("")

  nightsTotal Int     @default(0) // cena za noci
  feesTotal   Int     @default(0) // úklid + poplatek z pobytu
  totalPrice  Int                 // nightsTotal + feesTotal − discount

  // Uplatněný voucher — snímek v době rezervace, pozdější úprava voucheru ho nemění
  voucherCode  String  @default("")
  voucherKind  String  @default("")   // pct | czk
  voucherValue Int     @default(0)
  discount     Int     @default(0)    // sleva v Kč
  // DPH v době rezervace (0 = ubytovatel nebyl plátce); obsažené v ceně
  vatRate      Int     @default(0)
  vatAmount    Int     @default(0)

  note       String   @default("")
  source     String   @default("web") // web | manual | airbnb | booking
  status     String   @default("pending")
  expiresAt  DateTime?                // nezaplacená rezervace po expiraci uvolní termín
  // Souhlas hosta s obchodními podmínkami: kdy a s jakou verzí (termsUpdatedAt webu)
  termsAcceptedAt DateTime?
  termsVersion    String   @default("")
  createdAt  DateTime @default(now())
  cleaning   Cleaning?

  @@index([siteId, startDate, endDate])
}

// Blokace termínu majitelem (údržba, vlastní pobyt) — chová se jako obsazeno.
model Blackout {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([siteId, startDate, endDate])
}

model Cost {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  amount    Int
  category  String   @default("provoz")
  // Jednorázový náklad nastane v `date`. Opakovaný (monthly | yearly) začíná
  // v `date` a opakuje se ve stejný den měsíce/roku, dokud ho majitel neukončí.
  repeat    String   @default("once")
  endDate   DateTime? // poslední den, kdy se opakovaný náklad ještě počítá
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

// Slevový kód webu. Použití = nezrušené rezervace se stejným kódem.
model Voucher {
  id        String    @id @default(cuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code      String                         // velkými písmeny
  kind      String    @default("pct")      // pct = procenta, czk = pevná částka
  value     Int
  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date
  maxUses   Int?                           // null = bez omezení
  note      String    @default("")         // interní poznámka majitele
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@unique([siteId, code])
}

// Uklízečka webu. Přistupuje přes tajný odkaz /uklid/[token] (bez přihlášení).
model Cleaner {
  id        String     @id @default(cuid())
  siteId    String
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  token     String     @unique
  payMode   String     @default("hourly") // hourly = Kč/h, flat = Kč za úklid
  rate      Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  cleanings Cleaning[]
}

// Úklid: buď po odjezdu hostů z jedné rezervace (vzniká při přiřazení uklízečky),
// nebo ruční — bez rezervace, s vlastním datem, časem a popisem (vytvoří ho
// majitel, nebo si ho zapíše uklízečka).
model Cleaning {
  id            String       @id @default(cuid())
  siteId        String
  site          Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  date          DateTime?    @db.Date // jen ruční úklid
  time          String       @default("")
  title         String       @default("")
  createdBy     String       @default("owner") // owner | cleaner
  cleanerId     String?
  cleaner       Cleaner?    @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  checklist     String      @default("[]") // JSON [{id,label,done,extra}]
  minutes       Int?
  status        String      @default("todo") // todo | done
  finishedAt    DateTime?
  note          String      @default("")
  paid          Boolean     @default(false)
  paidAt        DateTime?
  amount        Int?        // částka v době zaplacení
  costId        String?     // záznam v Nákladech vytvořený při zaplacení
  createdAt     DateTime    @default(now())
}
